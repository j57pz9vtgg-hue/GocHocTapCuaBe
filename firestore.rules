rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/learning/{recordId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      allow read: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['schema', 'kind', 'key', 'body', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.kind in ['attempt', 'worksheet', 'classification', 'preferences']
        && request.resource.data.key is string && request.resource.data.key.size() <= 500
        && request.resource.data.body is string && request.resource.data.body.size() <= 700000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}

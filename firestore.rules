rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/learning/{recordId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
      }
      function deleting() {
        return exists(/databases/$(database)/documents/users/$(userId)/learning/_accountDeletion);
      }
      allow read: if owner();
      // Keep this minimal marker after account deletion to reject stale clients.
      allow create: if owner() && recordId == '_accountDeletion'
        && request.resource.data.keys().hasOnly(['deleting', 'updatedAt'])
        && request.resource.data.deleting == true && request.resource.data.updatedAt == request.time;
      allow create, update: if owner() && recordId != '_accountDeletion' && !deleting()
        && request.resource.data.keys().hasOnly(['schema', 'kind', 'key', 'body', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.kind in ['attempt', 'worksheet', 'classification', 'preferences']
        && request.resource.data.key is string && request.resource.data.key.size() <= 500
        && request.resource.data.body is string && request.resource.data.body.size() <= 700000
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner() && recordId != '_accountDeletion' && deleting();
    }
  }
}
